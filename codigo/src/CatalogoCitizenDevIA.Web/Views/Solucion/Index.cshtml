@model CatalogoViewModel
@{
    ViewData["Title"] = "Catálogo de Soluciones Citizen Development";
    string TagNivel(string nivel) => nivel switch
    {
        "Nivel 1" => "tag-nivel-1",
        "Nivel 2" => "tag-nivel-2",
        "Nivel 3" => "tag-nivel-3",
        _ => "tag-neutral"
    };

    // Colores de Estado en el Catálogo (retroalimentacion de usuarios,
    // 2026-09-08): Aprobado en verde, Rechazado en rojo — clases ya
    // definidas en 04-identidad-visual.md para Nivel 1/3, reutilizadas aquí.
    // Se completan además "En revisión" (ámbar, como Nivel 2) y
    // "Reclasificado" (violeta, tag-reclasificado) para no dejar el resto de
    // estados a medias; "Registrado" se mantiene neutro/gris.
    string TagEstado(string estado) => estado switch
    {
        var e when e.StartsWith("Aprobado") => "tag-nivel-1",
        "Rechazado" => "tag-nivel-3",
        "En revisión" => "tag-nivel-2",
        "Reclasificado" => "tag-reclasificado",
        _ => "tag-neutral"
    };
}
<h1 style="font-size:20px;margin-top:0;">Catálogo de Soluciones Citizen Development</h1>
<p class="form-hint">Repositorio único de soluciones de Citizen Development &amp; IA registradas por los equipos de Yanbal.</p>

<form method="get" class="card-surface" style="padding:16px;margin:16px 0;display:flex;gap:10px;flex-wrap:wrap;align-items:end;">
    <div>
        <label class="form-label">Buscar</label>
        <input type="text" name="Texto" value="@Model.Filtro.Texto" placeholder="Nombre o código" style="padding:8px 10px;border:1px solid var(--border);border-radius:8px;" />
    </div>
    <div>
        <label class="form-label">Nivel de riesgo</label>
        <select name="NivelRiesgo" style="padding:8px 10px;border:1px solid var(--border);border-radius:8px;">
            <option value="">Todos</option>
            @foreach (var n in new[] { "Nivel 1", "Nivel 2", "Nivel 3" })
            {
                <option value="@n" selected="@(Model.Filtro.NivelRiesgo == n)">@n</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label">Estado</label>
        <select name="Estado" style="padding:8px 10px;border:1px solid var(--border);border-radius:8px;">
            <option value="">Todos</option>
            @foreach (var e in Solucion.EstadosValidos)
            {
                <option value="@e" selected="@(Model.Filtro.Estado == e)">@e</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label">Plataforma</label>
        <select name="PlataformaId" style="padding:8px 10px;border:1px solid var(--border);border-radius:8px;">
            <option value="">Todas</option>
            @foreach (var p in Model.Plataformas)
            {
                <option value="@p.PlataformaId" selected="@(Model.Filtro.PlataformaId == p.PlataformaId)">@p.Nombre</option>
            }
        </select>
    </div>
    <button type="submit" class="btn-outline-brand">Filtrar</button>
    <a asp-action="Index" class="btn-outline-brand">Limpiar</a>
</form>

<div class="card-surface" style="overflow-x:auto;">
    <table class="table-clean">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Tipo</th>
                <th>País / Área</th>
                <th>Plataforma</th>
                <th>Dueño</th>
                <th>Nivel de riesgo</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Soluciones.Count == 0)
            {
                <tr><td colspan="9" style="text-align:center;color:var(--ink-soft);padding:24px;">Aún no hay soluciones registradas con estos filtros.</td></tr>
            }
            @foreach (var s in Model.Soluciones)
            {
                <tr>
                    <td class="font-mono">@s.CodigoSolucion</td>
                    <td>@s.Nombre</td>
                    <td>@s.TipoSolucion</td>
                    <td>@s.Pais / @s.Area</td>
                    <td>@Model.NombrePlataformaPorId.GetValueOrDefault(s.PlataformaId, "—")</td>
                    <td>@Model.NombreDuenioPorId.GetValueOrDefault(s.UsuarioDuenioId, "—")</td>
                    <td><span class="tag @TagNivel(s.NivelRiesgo)">@s.NivelRiesgo</span></td>
                    <td><span class="tag @TagEstado(s.Estado)">@s.Estado</span></td>
                    <td style="white-space:nowrap;">
                        <div style="display:flex;gap:10px;align-items:center;">
                            <a asp-action="Details" asp-route-id="@s.SolucionId">Ver detalle</a>
                            @if (User.GetEsAdministrador())
                            {
                                <form method="post" asp-action="Eliminar" asp-route-id="@s.SolucionId" class="js-confirmar-eliminar"
                                      data-mensaje="@($"¿Eliminar la solución {s.CodigoSolucion} — {s.Nombre}? Esta acción no se puede deshacer.")" style="margin:0;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" style="background:none;border:none;padding:0;color:var(--nivel3);cursor:pointer;font-size:inherit;text-decoration:underline;">Eliminar</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
<script src="~/js/catalogo-ui.js" asp-append-version="true"></script>
}
